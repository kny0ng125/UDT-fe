{
  "name": "udt-frontend",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@udt/web",
    "dev:admin": "turbo run dev --filter=@udt/admin",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@udt/web",
    "build:admin": "turbo run build --filter=@udt/admin",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test --filter=@udt/web",
    "storybook": "turbo run storybook",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
